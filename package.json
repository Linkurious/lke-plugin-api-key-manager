{
  "name": "@linkurious/lke-plugin-api-key-manager",
  "version": "1.0.0",
  "description": "API Key Manager for Linkurious Enterprise",
  "homepage": "https://github.com/Linkurious/lke-plugin-api-key-manager#readme",
  "bugs": {
    "url": "https://github.com/Linkurious/lke-plugin-api-key-manager/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkurious/lke-plugin-api-key-manager.git"
  },
  "engines": {
    "node": "24.14.1"
  },
  "author": "Linkurious",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "npm-package-name": "echo ${npm_package_name}-${npm_package_version}.tgz | sed -e 's/@//' -e 's/\\//-/'",
    "plugin-name": "echo ${npm_package_name} | sed -e 's/^@.*\\///' -e s/^lke-plugin-//",
    "artifact-name": "echo lke-plugin-$(npm run --silent plugin-name).lke",
    "clean": "npm run clean --workspace=@linkurious/lke-plugin-api-key-manager-frontend && rm -rf *.tgz *.lke",
    "lint": "npm run --workspaces lint",
    "lint:ci": "npm run --workspaces lint:ci",
    "tsc": "tsc -b tsconfig.base.json",
    "frontend": "npm run build --workspace=@linkurious/lke-plugin-api-key-manager-frontend",
    "prebuild": "rm -rf ./dist && rm -rf node_modules && npm install --workspaces --omit=dev && mkdir -p ./dist ./dist/backend && cp -R ./node_modules ./dist/node_modules && cp -R ./packages/backend/ ./dist/backend/node_modules && npm install --workspaces",
    "build": "npm run build --workspace=@linkurious/lke-plugin-api-key-manager-backend && npm run frontend",
    "postbuild": "cp LICENSE manifest*.json dist/ && mkdir -p tmp/github_release && tar -czf $(npm run --silent npm-package-name) dist/ && mv $(npm run --silent npm-package-name) $(npm run --silent artifact-name) && ln -sf $(pwd)/packages/frontend/public/lke-plugin-api-key-manager.lke $(pwd)/tmp/github_release/lke-plugin-api-key-manager-v$(cat .version).lke",
    "deploy:login": "curl -X POST $npm_config_deploy_url/api/auth/login --cookie-jar 'lke.cookie' -H 'Content-type: application/json' -d '{ \"usernameOrEmail\": \"'$npm_config_deploy_user'\", \"password': \"'$npm_config_deploy_pass'\" }'",
    "deploy:logout": "curl -X GET $npm_config_deploy_url/api/auth/logout --cookie 'lke.cookie'  -H 'Content-type: application/json' && rm lke.cookie",
    "predeploy:restart-plugins": "npm run deploy:login",
    "deploy:restart-plugins": "curl -X POST $npm_config_deploy_url/api/admin/plugins/restart-all --cookie 'lke.cookie'",
    "postdeploy:restart-plugins": "npm run deploy:logout",
    "deploy": "cp $(npm run --silent artifact-name) $npm_config_deploy_plugin_folder",
    "postdeploy": "npm run deploy:restart-plugins",
    "build-deploy": "npm run build && npm run deploy",
    "manual-upload": "gh release create \"v$(cat .version)\" $(npm run --silent artifact-name)",
    "bump:patch": "bump2version patch && npm version --no-git-tag-version patch",
    "bump:minor": "bump2version minor && npm version --no-git-tag-version minor",
    "bump:major": "bump2version major && npm version --no-git-tag-version major",
    "dev:backend": "npm run dev --workspace=@linkurious/lke-plugin-api-key-manager-backend",
    "dev:devserver": "npm run dev --workspace=@linkurious/lke-plugin-api-key-manager-dev",
    "dev:frontend": "npm run dev --workspace=@linkurious/lke-plugin-api-key-manager-frontend",
    "dev": "npm-run-all --parallel dev:devserver dev:frontend"
  },
  "license": "Apache 2",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.14.1",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-workspaces": "0.12.1",
    "npm-run-all": "4.1.5",
    "typescript": "5.5.2"
  }
}
