{
  "name": "@linkurious/lke-plugin-api-key-manager-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "esbuild src/*.ts --bundle --outdir=public/bundles --target=es6 --platform=browser --sourcemap --watch",
    "build": "cp -r public ../../dist/ && esbuild src/*.ts --bundle --outdir=../../dist/public/bundles --target=es6 --platform=browser --sourcemap --minify",
    "clean": "rm -rf public/bundles"
  },
  "devDependencies": {
    "@linkurious/rest-client": "4.3.5",
    "@lke-plugin/backend": "file:../backend",
    "esbuild": "0.28.0",
    "typescript": "4.9.4"
  }
}
