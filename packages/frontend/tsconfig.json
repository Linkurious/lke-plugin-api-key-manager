{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "rootDir": "./",
    "module": "commonjs",
    "target": "ESNext",
    "moduleResolution": "node",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx"
  },
  "include": [
    "**/*.ts",
    "src/index.ts"
  ],
  "exclude": [
    "../backend/**/*.ts",
    "../dev/**/*.ts"
  ]
}
